{
  "project": {
    "name": "deep@7.2.0"
  },
  "architecture": {
    "folders": {
      "**/*": "В корне лежит ТОЛЬКО код реализации оснвного функционала, остальное по папкам",
      "scripts": "Ручные эксперименты запускаемые через node ./scripts/script.js",
      "tests": "Проверка конечного стабильного функционала",
      "tests": "Тесты, только проверка стабильных реализаций, честно отвечает на вопрос реализованности проекта. Тесты всегда должны ипользовать safe методы (без _ префикса)."
    },
    "files": {
      "*.test.js": "На один файл функционала [name].js приходится один файл [name].test.js",
      "*.benchmark.js": "На один файл функционала [name].js приходится один файл [name].benchmark.js. При создании файла важно добавить его в scripts/benchmarkify.js (BENCHMARK_DOCS_MAP), чтобы результаты автоматически обновлялись в соответствующем md-файле.",
      "*.md": "Документация в корне. На один файл функционала [name].js приходится один файл [NAME].md с документацией (название в верхнем регистре, а расширение - в нижнем). Каждый md-файл должен содержать заголовок # Производительность после первого заголовка и описания."
    }
  },
  "aiConfig": {
    "language": "ru-RU"
  },
  "persistence": {
    "reminders": {
      "interval": 1
    }
  },
  "dependencies": {
    "preference": "Предпочтение отдается встроенным пакетам Node.js (node:test, node:assert и др.), сторонние пакеты используются только когда необходимо"
  }
}
