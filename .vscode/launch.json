{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Запустить все тесты",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "runtimeArgs": [
        "--test"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Запустить текущий тест",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "runtimeArgs": [
        "--test"
      ],
      "program": "${file}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Запустить конкретный тест",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "runtimeArgs": [
        "--test",
        "--test-name-pattern=${input:testName}"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Запустить текущий файл",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${file}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "inputs": [
    {
      "id": "testName",
      "type": "promptString",
      "description": "Введите имя теста для запуска",
      "default": "Association"
    }
  ]
}
